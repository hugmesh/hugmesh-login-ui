{
  "name": "@hugmesh/login",
  "version": "0.3.0-beta.1",
  "description": "Native username/password login + two-stage registration (Casdoor brokered server-side, no browser redirect) — Angular native-federation remote for the hugmesh.net host.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve login",
    "build": "ng build login",
    "build:login": "ng build login",
    "test": "ng test login --watch=false --browsers=ChromeHeadlessCI",
    "pretest": "npm run federation:check && npm run mirror:check && npm run docker:context && npm run docker:test && npm run csp:test",
    "prebuild": "npm run federation:check && npm run mirror:check && npm run docker:context && npm run docker:test && npm run csp:test",
    "test:watch": "ng test login",
    "i18n:extract": "ng extract-i18n login --format=xlf2 --output-path=src/locale --out-file=messages.xlf",
    "i18n:pseudo": "node tools/i18n/make-pseudo.mjs",
    "i18n:prepare": "node tools/i18n/emit-shipped-locales.mjs",
    "i18n:catalogs": "node tools/i18n/build-catalogs.mjs",
    "i18n:check": "node tools/i18n/check-catalogs.mjs",
    "i18n:test": "node --test \"tools/i18n/*.test.mjs\"",
    "federation:check": "node tools/federation/check-exposes.mjs",
    "mirror:census": "node tools/fleet-mirror/census.mjs",
    "mirror:check": "node tools/fleet-mirror/census.mjs --self",
    "mirror:test": "node --test \"tools/fleet-mirror/*.test.mjs\"",
    "docker:context": "node tools/docker/check-context.mjs",
    "docker:test": "node --test \"tools/docker/*.test.mjs\"",
    "csp:test": "node --test \"tools/csp/*.test.mjs\"",
    "build:image": "npm run federation:check && npm run mirror:check && npm run docker:context && npm run i18n:check && npm run i18n:prepare && npm run build:login && npm run i18n:catalogs",
    "gen": "ng-openapi-gen",
    "gen:spec": "cp \"${ADMIN_BFF_SPEC:-../hugmesh-admin-bff-api/src/main/resources/openapi/openapi.json}\" openapi.json && npm run gen"
  },
  "dependencies": {
    "@angular-architects/native-federation": "^22.0.0",
    "@angular/animations": "^22.0.2",
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/forms": "^22.0.2",
    "@angular/localize": "22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "@angular/platform-browser-dynamic": "^22.0.2",
    "@angular/router": "^22.0.2",
    "@softarc/native-federation-node": "^3.5.5",
    "es-module-shims": "^2.8.1",
    "rxjs": "^7.8.2",
    "three": "^0.185.1",
    "tslib": "^2.6.0",
    "vanta": "^0.5.24",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.0.2",
    "@types/jasmine": "^6.0.0",
    "jasmine-core": "^6.3.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "karma-junit-reporter": "^2.0.1",
    "ng-openapi-gen": "^0.51.0",
    "ng-packagr": "^22.0.0",
    "typescript": "~6.0.3"
  }
}
